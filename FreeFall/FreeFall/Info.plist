<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Free Fall</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>doordash</string>
		<string>googlechrome</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>FreeFall adds events to your calendar.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>FreeFall adds events to your calendar.</string>
	<key>NSContactsUsageDescription</key>
	<string>Free Fall accesses your contacts to send Apple Cash payments on your behalf.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Free Fall uses Face ID to authorize Apple Cash payments.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>FreeFall uses your location to find nearby restaurants, calculate travel times, and check weather.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>FreeFall creates reminders for you.</string>
	<key>NSRemindersUsageDescription</key>
	<string>FreeFall creates reminders for you.</string>
	<key>NSSiriUsageDescription</key>
	<string>Free Fall uses Siri to initiate Apple Cash transfers.</string>
</dict>
</plist>
